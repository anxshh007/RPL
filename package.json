{
  "name": "repopilot-ai",
  "displayName": "RepoPilot AI",
  "description": "An Impact-Aware Autonomous Coding Agent with Automated Verification",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Machine Learning",
    "Testing"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "build": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "typecheck": "tsc --noEmit -p ./",
    "test": "npm run build && node --test dist/tests/unit/**/*.test.js dist/tests/integration/**/*.test.js",
    "test:unit": "npm run build && node --test dist/tests/unit/**/*.test.js",
    "test:integration": "npm run build && node --test dist/tests/integration/**/*.test.js",
    "test:watch": "tsc -watch -p ./ & node --test --watch dist/tests/**/*.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.0",
    "@truefoundry/trueforge-sdk": "^0.185.0",
    "diff": "^7.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/diff": "^7.0.0",
    "@types/node": "^22.13.1",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
