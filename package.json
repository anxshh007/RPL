{
  "name": "repopilot-ai",
  "displayName": "RepoPilot AI",
  "description": "Impact-aware coding agent for VS Code with hunk-level human approval and automated test verification.",
  "version": "0.0.1",
  "publisher": "your-team-id",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["AI", "Programming Languages"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/src/extension/extension.js",
  "contributes": {
    "commands": [
      { "command": "repopilot.open", "title": "RepoPilot: Open Panel" },
      { "command": "repopilot.inlineEdit", "title": "RepoPilot: Edit Selection" }
    ],
    "keybindings": [
      {
        "command": "repopilot.inlineEdit",
        "key": "ctrl+shift+alt+e",
        "mac": "cmd+shift+alt+e",
        "when": "editorHasSelection"
      }
    ],
    "configuration": {
      "title": "RepoPilot AI",
      "properties": {
        "repopilot.trueforge.baseUrl": {
          "type": "string",
          "default": "",
          "description": "TrueForge server URL. Member 1 sets the documented default after verifying it in the TrueForge docs."
        },
        "repopilot.context.tokenBudget": {
          "type": "number",
          "default": 16000,
          "description": "Approximate context budget (estimated tokens, not exact)."
        },
        "repopilot.tests.timeoutMs": {
          "type": "number",
          "default": 120000,
          "description": "Maximum time for one TestSheriff run."
        },
        "repopilot.tests.requireApproval": {
          "type": "boolean",
          "default": true,
          "description": "Ask before TestSheriff runs tests."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "node --test out/tests/unit/shared/contracts.test.js out/tests/unit/agent/controller.test.js out/tests/unit/repository/context-intelligence.test.js out/tests/unit/repository/dependency-index.test.js out/tests/unit/repository/file-metadata.test.js out/tests/unit/repository/incremental-index.test.js out/tests/unit/repository/path-safety.test.js out/tests/unit/repository/python-symbol-index.test.js out/tests/unit/repository/ripgrep-search.test.js out/tests/unit/repository/workspace-scanner.test.js out/tests/unit/repository/tools.test.js out/tests/unit/impact/fixtures.test.js out/tests/unit/impact/dependency-graph.test.js out/tests/unit/impact/impact-analyser.test.js"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@vscode/tree-sitter-wasm": "0.3.1"
  }
}
