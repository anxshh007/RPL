# RepoPilot AI - Environment Configuration Example
# Copy this file to .env for local overrides (never commit real secrets)

# TrueForge Local Agent Harness Base URL (default: http://127.0.0.1:8790)
TRUEFORGE_BASE_URL=http://127.0.0.1:8790

# TrueForge Optional Authentication Token / API Key (leave blank for local development)
TRUEFORGE_API_KEY=

# Agent Identifier registered in TrueForge
TRUEFORGE_AGENT_ID=repopilot-core

# Request timeout in milliseconds (default: 30000)
TRUEFORGE_TIMEOUT_MS=30000

# Maximum retry attempts for transient network failures (default: 2)
TRUEFORGE_MAX_RETRIES=2
